<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.TikTokTech" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/marinho</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/marinho_claro</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <item name="colorSecondary">@color/ambar</item>
        <item name="colorOnSecondary">@color/marinho</item>
        <item name="colorSecondaryContainer">@color/ambar</item>
        <item name="colorOnSecondaryContainer">@color/marinho</item>

        <item name="android:colorBackground">@color/fundo</item>
        <item name="colorSurface">@color/superficie</item>
        <item name="colorOnSurface">@color/texto_forte</item>
        <item name="colorSurfaceVariant">@color/superficie_fraca</item>
        <item name="colorOnSurfaceVariant">@color/texto_medio</item>
        <item name="colorOutline">@color/divisor</item>

        <item name="android:statusBarColor">@color/marinho</item>
        <item name="android:navigationBarColor">@color/fundo</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.TikTokTech" parent="Base.Theme.TikTokTech" />

    <style name="Theme.TikTokTech.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/icone_fundo</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.TikTokTech</item>
    </style>

    <!-- ===== Estilos reaproveitados nas telas ===== -->

    <style name="Texto.Titulo" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- Rótulo pequeno em maiúsculas, tipo "badge" de status do GitHub -->
    <style name="Texto.Rotulo" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/texto_fraco</item>
    </style>

    <!-- Texto em fonte monoespaçada, para URLs e status (visual de "code block") -->
    <style name="Texto.Codigo" parent="">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/texto_forte</item>
        <item name="android:textIsSelectable">true</item>
    </style>

    <style name="Widget.TikTokTech.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/marinho</item>
        <item name="titleTextAppearance">@style/Texto.Titulo</item>
        <item name="navigationIconTint">@color/white</item>
    </style>

    <style name="Widget.TikTokTech.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/divisor</item>
        <item name="cardBackgroundColor">@color/superficie</item>
    </style>

    <!-- Botão primário, tipo "Merge" do GitHub: verde, cantos discretos -->
    <style name="Widget.TikTokTech.Botao" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/verde_github</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">6dp</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <!-- Botão azul, cor de destaque do GitHub (links/ações como "New") -->
    <style name="Widget.TikTokTech.Botao.Azul" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/ambar</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">6dp</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <!-- Botão secundário, tipo botão outline do GitHub: fundo neutro, borda fina -->
    <style name="Widget.TikTokTech.Botao.Secundario" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/texto_forte</item>
        <item name="iconTint">@color/texto_forte</item>
        <item name="strokeColor">@color/divisor</item>
        <item name="backgroundTint">@color/superficie_fraca</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="cornerRadius">6dp</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <style name="Widget.TikTokTech.Campo" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">6dp</item>
        <item name="boxCornerRadiusTopEnd">6dp</item>
        <item name="boxCornerRadiusBottomStart">6dp</item>
        <item name="boxCornerRadiusBottomEnd">6dp</item>
        <item name="boxStrokeColor">@color/ambar</item>
        <item name="hintTextColor">@color/texto_medio</item>
        <item name="android:textColorHint">@color/texto_fraco</item>
    </style>

    <style name="Contador" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">22dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/texto_medio</item>
    </style>

    <!-- Arredonda só o topo da foto, para casar com o canto do card -->
    <style name="Imagem.TopoArredondado" parent="">
        <item name="cornerSizeTopLeft">8dp</item>
        <item name="cornerSizeTopRight">8dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
